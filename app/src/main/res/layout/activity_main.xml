<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_pastel_gradient"
    android:padding="20dp">

    <!-- 3D Floating Orbs -->
    <View
        android:id="@+id/orbTopLeft"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:background="@drawable/bg_orb_glass"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="60dp"
        android:layout_marginStart="20dp" />

    <View
        android:id="@+id/orbRightPink"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:background="@drawable/bg_orb_pink"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="260dp"
        android:layout_marginEnd="30dp" />

    <View
        android:id="@+id/orbBottomCyan"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:background="@drawable/bg_orb_cyan"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="70dp"
        android:layout_marginEnd="40dp" />

    <!-- Glassmorphic Main Calculator Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/calculatorCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/glass_card_bg"
        app:cardCornerRadius="32dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/glass_card_stroke"
        app:strokeWidth="1.5dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Window Control Dots -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <View android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/bg_dot" android:layout_marginEnd="6dp"/>
                <View android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/bg_dot" android:layout_marginEnd="6dp"/>
                <View android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/bg_dot"/>
            </LinearLayout>

            <!-- Display Area -->
            <TextView
                android:id="@+id/tvExpression"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="(62 × 25) + 471"
                android:textColor="@color/text_expression"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvDisplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="2021"
                android:textColor="@color/text_result"
                android:textSize="44sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <!-- Keypad Grid -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="4"
                android:rowCount="5">

                <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnClear" android:text="C" style="@style/GlassBtnStyle"/>
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnSign" android:text="±" style="@style/GlassBtnStyle"/>
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnPercent" android:text="%" style="@style/GlassBtnStyle"/>
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnDivide" android:text="÷" style="@style/GlassBtnStyle"/>

                <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn7" android:text="7" style="@style/GlassBtnStyle"/>
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn8" android:text="8" style="@style/GlassBtnStyle"/>
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn9" android:text="9" style="@style/GlassBtnStyle"/>
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnMultiply" android:text="×" style="@style/GlassBtnStyle"/>

                <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn4" android:text="4" style="@style/GlassBtnStyle"/>
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn5" android:text="5" style="@style/GlassBtnStyle"/>
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn6" android:text="6" style="@style/GlassBtnStyle"/>
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnMinus" android:text="−" style="@style/GlassBtnStyle"/>

                <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn1" android:text="1" style="@style/GlassBtnStyle"/>
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn2" android:text="2" style="@style/GlassBtnStyle"/>
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn3" android:text="3" style="@style/GlassBtnStyle"/>
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnPlus" android:text="+" style="@style/GlassBtnStyle"/>

                <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnDot" android:text="." style="@style/GlassBtnStyle"/>
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn0" android:text="0" style="@style/GlassBtnStyle"/>
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnEnter" android:text="Enter" style="@style/EnterBtnStyle"/>
            </GridLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
