<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CalculatorApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/bg_gradient_start</item>
    </style>

    <!-- Base Glassmorphic Button Style -->
    <style name="GlassButtonNum">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:backgroundTint">@color/btn_glass_num</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">20dp</item>
        <item name="strokeColor">@color/glass_border</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="GlassButtonOp" parent="GlassButtonNum">
        <item name="android:backgroundTint">@color/btn_glass_op</item>
        <item name="android:textColor">@color/btn_op_text</item>
    </style>

    <style name="GlassButtonAction" parent="GlassButtonNum">
        <item name="android:backgroundTint">@color/btn_glass_action</item>
        <item name="android:textColor">@color/btn_action_text</item>
    </style>

    <style name="GlassButtonEquals" parent="GlassButtonNum">
        <item name="android:backgroundTint">@color/btn_glass_equals</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
</resources>
