<resources>
    <!-- Regular Glass Keypad Button -->
    <style name="GlassBtnStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">58dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:background">@drawable/bg_glass_button</item>
        <item name="android:textColor">@color/btn_text_purple</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Cyan Enter Button -->
    <style name="EnterBtnStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">58dp</item>
        <item name="android:layout_columnSpan">2</item>
        <item name="android:layout_columnWeight">2</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:background">@drawable/bg_enter_button</item>
        <item name="android:textColor">@color/btn_enter_text</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>

